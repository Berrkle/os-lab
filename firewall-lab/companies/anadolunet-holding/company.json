  "summary": "AnadoluNet is a technology holding with an Izmir headquarters and software team, offices in Bursa (with an isolated OT production VLAN) and Berlin (GDPR), and an Eskisehir academy campus of 8,000 students. Hub-and-spoke IPsec IKEv2 tunnels meet at the Izmir firewalls; every site is default-deny with explained rules, per-user QoS and a central SIEM.",
  "branches": [
    {
      "id": "izmir-hq",
      "name": "Izmir HQ + Software Team",
      "role": "headquarters",
      "location": "Izmir, Turkey",
      "population": {
        "staff": 300,
        "software": 80
      },
      "network": {
        "cidr": "10.10.0.0/16",
        "dmz": true,
        "vlans": [
          {
            "id": 10,
            "name": "management",
            "cidr": "10.10.10.0/24",
            "note": "Firewall, switch and server management."
          },
          {
            "id": 20,
            "name": "staff",
            "cidr": "10.10.20.0/23",
            "note": "Office staff."
          },
          {
            "id": 30,
            "name": "software",
            "cidr": "10.10.30.0/24",
            "note": "Software team, separate floor."
          },
          {
            "id": 40,
            "name": "servers",
            "cidr": "10.10.40.0/24",
            "note": "ERP, AD, mail; Git/CI in 10.10.40.48/28. DMZ 172.16.40.0/24 is kept in a separate private block."
          }
        ]
      },
      "bandwidth": {
        "downMbps": 2500,
        "upMbps": 2500,
        "drivers": [
          "ERP",
          "Git/CI",
          "VPN hub traffic",
          "video conferencing",
          "SIEM logs"
        ]
      },
      "firewalls": [
        {
          "segment": "perimeter",
          "chosen": {
            "product": "PA-3400 series (HA)",
            "vendor": "Palo Alto Networks",
            "reason": "Strongest threat prevention for the VPN hub; manages all sites via Panorama."
          },
          "alternatives": [
            {
              "product": "FortiGate 400F / 600F class (HA)",
              "vendor": "Fortinet",
              "reason": "High IPsec performance for a VPN hub, built-in SD-WAN."
            },
            {
              "product": "Quantum 6000 series",
              "vendor": "Check Point",
              "reason": "Strong policy management."
            },
            {
              "product": "Secure Firewall 3100 series",
              "vendor": "Cisco",
              "reason": "Fits enterprise Cisco infrastructure."
            },
            {
              "product": "XGS 5500 / 6500",
              "vendor": "Sophos",
              "reason": "More cost-effective and easy to manage."
            }
          ],
          "rules": [
            {
              "action": "allow",
              "direction": "in",
              "proto": "tcp",
              "port": "22,443",
              "from": "vlan10-management",
              "to": "all-devices",
              "note": "IT team manages devices only from Management VLAN 10 (SSH/HTTPS)."
            },
            {
              "action": "allow",
              "direction": "in",
              "proto": "tcp",
              "port": 443,
              "from": "any",
              "to": "dmz-web",
              "note": "Public website is reachable on HTTPS only, with the IPS profile enabled."
            },
            {
              "action": "allow",
              "direction": "in",
              "proto": "tcp",
              "port": "389,636,993,8443",
              "from": "vlan20-staff",
              "to": "vlan40-servers",
              "note": "Staff reach ERP, LDAP and mail on the internal server VLAN."
            },
            {
              "action": "allow",
              "direction": "in",
              "proto": "tcp",
              "port": "22,443",
              "from": "vlan30-software",
              "to": "git-ci",
              "note": "Software team reaches Git/CI servers only (SSH 22, HTTPS)."
            },
            {
              "action": "deny",
              "direction": "in",
              "proto": "any",
              "from": "vlan30-software",
              "to": "vlan20-staff",
              "note": "Software and staff teams are isolated from each other."
            },
            {
              "action": "allow",
              "direction": "out",
              "proto": "tcp",
              "port": "80,443",
              "from": "internal-vlans",
              "to": "any",
              "note": "All internal VLANs browse the internet through web filter and QoS."
            },
            {
              "action": "deny",
              "direction": "in",
              "proto": "any",
              "from": "dmz",
              "to": "internal-vlans",
              "note": "If the DMZ is compromised, the internal network stays unreachable."
            },
            {
              "action": "deny",
              "direction": "in",
              "proto": "any",
              "from": "any",
              "to": "any",
              "note": "Default rule: deny everything else and log it."
            }
          ]
        },
        {
          "segment": "software",
          "chosen": {
            "product": "FortiGate 200F class (ISFW mode)",
            "vendor": "Fortinet",
            "reason": "Mode designed for high-speed segmentation between internal networks."
          },
          "alternatives": [
            {
              "product": "PA-1400 series",
              "vendor": "Palo Alto Networks",
              "reason": "Fine-grained user- and application-based rules."
            },
            {
              "product": "Quantum 3000 series",
              "vendor": "Check Point",
              "reason": "Same management console as HQ."
            },
            {
              "product": "Secure Firewall 1200 / 3100",
              "vendor": "Cisco",
              "reason": "Segmentation alongside Cisco switches."
            },
            {
              "product": "OPNsense / pfSense",
              "vendor": "Netgate / Deciso",
              "reason": "Free and flexible for test and dev environments."
            }
          ],
          "rules": [
            {
              "action": "allow",
              "direction": "forward",
              "proto": "tcp",
              "port": "22,443",
              "from": "vlan30-software",
              "to": "git-ci",
              "note": "East-west traffic of the 80 developers to Git/CI servers (about 2 Gbps internal)."
            },
            {
              "action": "deny",
              "direction": "forward",
              "proto": "any",
              "from": "vlan30-software",
              "to": "vlan20-staff",
              "note": "Developer VLAN cannot wander into the staff VLAN."
            }
          ]
        },
        {
          "segment": "dmz",
          "chosen": {
            "product": "Cloudflare WAF",
            "vendor": "Cloudflare",
            "reason": "Global network absorbs very large DDoS attacks; ready-made OWASP rules."
          },
          "alternatives": [
            {
              "product": "AWS WAF",
              "vendor": "Amazon",
              "reason": "Native integration since the website runs on AWS."
            },
            {
              "product": "App & API Protector",
              "vendor": "Akamai",
              "reason": "Strong bot protection, widely used in large enterprises."
            },
            {
              "product": "Imperva WAF",
              "vendor": "Imperva",
              "reason": "Strong in database and API protection."
            },
            {
              "product": "Advanced WAF / Distributed Cloud",
              "vendor": "F5",
              "reason": "Also offers an on-prem option."
            }
          ],
          "rules": [
            {
              "action": "allow",
              "direction": "in",
              "proto": "tcp",
              "port": 443,
              "from": "any",
              "to": "dmz-web",
              "note": "Only HTTPS from the internet to the web server in the DMZ."
            },
            {
              "action": "deny",
              "direction": "in",
              "proto": "any",
              "from": "any",
              "to": "dmz",
              "note": "Anything else from the internet to the DMZ is dropped and logged."
            }
          ]
        }
      ]
    },
