# firewall-lab VM environment. Copy to .env and adjust.
#   cp .env.example .env

# --- Image ---------------------------------------------------------------
IMAGE_TAG=latest

# --- Guest ---------------------------------------------------------------
# Ubuntu Server (the OS we use for UFW). Any qemux distro shortcut works.
BOOT=ubuntu
BOOT_MODE=uefi

# Guest credentials. CHANGE FW_PASSWORD before exposing anything.
FW_USER=ubuntu
FW_PASSWORD=ubuntu

# --- Resources -----------------------------------------------------------
# A firewall practice box is small; 2 vCPU / 2 GB is plenty.
CPU_CORES=2
RAM_SIZE=2G
DISK_SIZE=16G
DISK_FMT=qcow2

# --- Access --------------------------------------------------------------
# Ports differ from linux-lab (8006/2222) so both can run at once.
# Bind to localhost only with e.g. 127.0.0.1:8007:8006 in docker-compose.yml.
WEB_PORT=8007
SSH_PORT=2223

DEBUG=N

# --- Waits ---------------------------------------------------------------
WEB_WAIT_TIMEOUT=180
SSH_WAIT_TIMEOUT=600
