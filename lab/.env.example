# Copy to .env and adjust. Loaded by docker compose and by scripts/wf*.sh.

# Emulator profile + image tag (emulator_9.0 … emulator_14.0, API 28–34)
EMULATOR_DEVICE=Samsung Galaxy S10
ANDROID_TAG=emulator_11.0

# MobSF REST API key — pinned so workflow scripts are deterministic.
# Change it; the key also shows in `docker compose logs mobsf` on first boot.
MOBSF_API_KEY=compact-lab-key
