# Copy to .env and adjust. Loaded by docker compose and by scripts/wf*.sh.
# Profiles and lifecycle: ../../labctl --help

# Lab mode: dynamic (emulator, needs KVM) or static (KVM-free analysis stack).
LAB_MODE=dynamic
# Emulator profile + image tag (emulator_9.0 … emulator_14.0, API 28–34)
EMULATOR_DEVICE="Samsung Galaxy S10"
ANDROID_TAG=emulator_11.0
# Docker-Android usage analytics, sent to its maintainers (Google Forms + ipinfo.io).
# os-lab disables them; set true to opt in. See ../../docs/legal/PRIVACY.md.
DOCKER_ANDROID_ANALYTICS=false
# Host limits for the emulator container. The guest uses the device profile.
ANDROID_CPUS=2
ANDROID_MEMORY=4g

# MobSF REST API key — pinned so workflow scripts are deterministic.
# Change it; the key also shows in `docker compose logs mobsf` on first boot.
MOBSF_API_KEY=compact-lab-key

# --- Ubuntu Server host setup (read by scripts/setup-ubuntu.sh) ----------
# Open the lab web ports in ufw (6080/8000/8080/8081).
OPEN_FIREWALL=no
# Pull container images during setup.
PULL_IMAGES=no
# Create .venv and install requirements.txt during setup.
SETUP_PYTHON=no
