# ios-lab environment. Copy to .env and adjust.
# Loaded by docker compose, scripts/*.sh and ../../labctl.

# --- Image ---------------------------------------------------------------
IMAGE_TAG=latest

# --- macOS install -------------------------------------------------------
# 15 (Sequoia) is the practical default. 26 (Tahoe) runs slowly on x86.
MACOS_VERSION=15
MAC_MODEL=iMacPro1,1

# --- Resources -----------------------------------------------------------
CPU_CORES=4
RAM_SIZE=8G
DISK_SIZE=128G
DISK_FMT=raw
ALLOCATE=N

# Reims vGPU requires a Vulkan-capable Intel/AMD GPU and /dev/dri.
# Enable with: make up-gpu   (or ../../labctl ios start with GPU=Y)
GPU=N

# --- Access --------------------------------------------------------------
# Web viewer on http://<server-ip>:8006/ ; VNC on 5900/tcp+udp.
WEB_PORT=8006
VNC_PORT=5900
# Password-protect the web viewer (uses the macOS login credentials).
WEB_PROTECT=N

# --- Lifecycle -----------------------------------------------------------
SHUTDOWN_TIMEOUT=115
DEBUG=N
WEB_WAIT_TIMEOUT=300

# --- Ubuntu host setup ---------------------------------------------------
OPEN_FIREWALL=no
PULL_IMAGES=no
