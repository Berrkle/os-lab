# linux-lab environment. Copy to .env and adjust.
# Loaded by docker compose and by scripts/*.sh.
# Profiles and lifecycle: ../labctl --help

# --- Image ---------------------------------------------------------------
# Pin a tag (for example 7.00) for reproducible deployments.
IMAGE_TAG=latest

# --- Guest ---------------------------------------------------------------
# Distro shortcut: ubuntu, debian, alpine, fedora, arch, kali, ...
# May also be an ISO URL; a local ./boot.iso overrides BOOT.
BOOT=ubuntu
# qemux boot mode: uefi (default), legacy, windows, or windows_legacy.
BOOT_MODE=uefi

# Guest credentials for the preinstalled image (where the image supports it).
LINUX_USER=root
LINUX_PASSWORD=root

# --- Resources -----------------------------------------------------------
CPU_CORES=2
RAM_SIZE=4G
DISK_SIZE=32G
DISK_FMT=qcow2

# --- Access --------------------------------------------------------------
# Host ports. Use 127.0.0.1:8006:8006 to bind to localhost only.
WEB_PORT=8006
SSH_PORT=2222

DEBUG=N

# --- Lab tooling ---------------------------------------------------------
# Set to "yes" to let scripts/setup-ubuntu.sh open ufw ports 8006/2222.
OPEN_FIREWALL=no
# Seconds waited by "make boot" for the web UI and by "make wait-ready" for SSH.
WEB_WAIT_TIMEOUT=180
SSH_WAIT_TIMEOUT=600
