# win-lab environment. Copy to .env and adjust.
# Loaded by docker compose and by scripts/*.sh.
# Profiles and lifecycle: ../labctl --help

# --- Image ---------------------------------------------------------------
# Pin a version (for example 6.06) for reproducible deployments.
IMAGE_TAG=latest

# --- Windows install -----------------------------------------------------
# 11, 11l (LTSC), 10, 10l, 2022, 2019, tiny11, core11, xp, ...
# May also be an ISO URL; a local ./custom.iso overrides VERSION.
VERSION=11
LANGUAGE=English
# Leave empty to derive from LANGUAGE.
REGION=
KEYBOARD=

# Windows account. CHANGE THE PASSWORD before first boot.
WINDOWS_USER=Docker
WINDOWS_PASSWORD=admin

# --- Resources -----------------------------------------------------------
CPU_CORES=2
RAM_SIZE=4G
DISK_SIZE=64G
DISK_FMT=raw
ALLOCATE=N

# --- Access --------------------------------------------------------------
# Host ports. Use 127.0.0.1:8006:8006 to bind to localhost only.
WEB_PORT=8006
RDP_PORT=3389

# Enable HTTP basic auth on the web viewer (uses WINDOWS_USER/PASSWORD).
WEB_PROTECT=N

# --- Sharing / lifecycle ------------------------------------------------
SAMBA=Y
SHORTCUT=Y
REMOVE_ISO=Y
SHUTDOWN=Y
SHUTDOWN_TIMEOUT=105
DEBUG=N

# --- Lab tooling ---------------------------------------------------------
# Set to "yes" to let scripts/setup-ubuntu.sh open ufw ports 8006/3389.
OPEN_FIREWALL=no
# Seconds waited by "make boot" for the web UI and by "make wait-install".
WEB_WAIT_TIMEOUT=180
INSTALL_WAIT_TIMEOUT=7200
