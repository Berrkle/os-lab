---
import Base from "../../layouts/Base.astro";
import { COMPANIES } from "../../firewall/companies.generated";
import { FirewallCompanyPage } from "../../views/firewall-company-page";
import "../../styles/firewall-company.css";

export function getStaticPaths() {
  return COMPANIES.map((company) => ({ params: { company: company.slug }, props: { company } }));
}

const { company } = Astro.props;
---
<Base title={`${company.name} · Firewall Lab`} description={`${company.name}: branches, VLANs, firewalls and rule sets in the os-lab firewall lab.`}>
  <FirewallCompanyPage company={company} client:only="react" />
</Base>
